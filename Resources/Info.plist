<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Scribe</string>
	<key>CFBundleIdentifier</key>
	<string>com.bartbak.scribe</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Scribe</string>
	<key>CFBundleDisplayName</key>
	<string>Scribe</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- No Dock icon, no app switcher: this is a menu bar app. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Scribe records your voice so it can transcribe it. Audio is processed entirely on this Mac and is never uploaded.</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Sparkle. Scribe ships outside the App Store, so this is the only route
	     a fix has to someone who already downloaded it.

	     SUPublicEDKey is the public half of the EdDSA key in the developer's
	     Keychain; the private half never leaves it. Sparkle refuses any update
	     whose signature does not match, which is what stops a compromised host
	     or a hijacked connection from serving a different app. It is deliberately
	     in the signed Info.plist: changing it means re-signing and re-notarizing,
	     so an attacker cannot swap the key that validates the payload.

	     One key covers every app a developer ships -- Sparkle's own tooling says
	     so -- and this is the same key ultra-swift uses. -->
	<key>SUFeedURL</key>
	<string>https://petit-software.github.io/clio/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>SribIcG3bOjhcAnl9uSgRmlTpXg4txE8gGCGSP05LX4=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Daily. A dictation utility does not need to ask more often, and every
	     check is a request from a user who did not ask for one. -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Downloads are applied on the user's say-so rather than silently: this
	     app is held open by a global event tap, and relaunching underneath
	     someone mid-sentence is worse than waiting. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
</dict>
</plist>
