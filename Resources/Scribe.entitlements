<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Deliberately NOT sandboxed. A session-level CGEventTap and posting
	  synthetic ⌘V are both incompatible with the App Sandbox, which is why
	  this app ships by direct download and not through the App Store (§9).
	-->
	<!--
	  The microphone. Required under the hardened runtime, which is on so the
	  app can be notarized later.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!--
	  Deliberately NOT here: com.apple.security.automation.apple-events. Scribe
	  sends no Apple Events. It pastes with a synthesized CGEvent and opens
	  System Settings through LaunchServices, neither of which is scripting.
	  Asking for it would be requesting a capability we never use.
	-->
</dict>
</plist>
